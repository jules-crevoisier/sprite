{
  "name": "pixelforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PixelForge — editeur de sprites et d'animation pixel-art pour le game dev, dans le navigateur.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:rotation": "node scripts/rotation-bench.mjs",
    "test:vues": "node scripts/vues-bench.mjs",
    "test": "npm run test:smoke && npm run test:rotation && npm run test:vues",
    "film:capture": "node scripts/film/capture.mjs --out video/assets",
    "film:render": "node scripts/film/render.mjs --assets video/assets --out video/pixelforge.mp4",
    "film:verifier": "node scripts/film/render.mjs --assets video/assets --verifier",
    "film": "npm run film:capture && npm run film:render"
  },
  "devDependencies": {
    "playwright": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "lucide": "^0.468.0"
  }
}
