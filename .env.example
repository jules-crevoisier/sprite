# Utile uniquement avec docker-compose.local.yml : port publie sur l'hote.
# Sur Dokploy, aucune variable n'est necessaire — le domaine se configure
# dans l'onglet Domains et Traefik joint le conteneur par le reseau interne.
PIXELFORGE_PORT=8080

# Identifiant client OAuth « Application Web » pour la sauvegarde dans Google
# Drive. Facultatif : sans lui, PixelForge fonctionne, et les entrees de menu
# Drive expliquent comment en creer un. Ce n'est pas un secret (il circule en
# clair a chaque connexion) ; ce sont les origines JavaScript autorisees,
# declarees dans la console Google Cloud, qui protegent le compte.
# Lu par Vite au moment du `npm run build`.
VITE_GOOGLE_CLIENT_ID=
